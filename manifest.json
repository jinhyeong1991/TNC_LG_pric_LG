{
  "manifest_version": 3,
  "name": "TNC LG전자 렌탈료 검수",
  "version": "0.1.1",
  "description": "LG전자(단독몰) 엑셀의 카테고리별 구독료·방문주기·서비스타입을 사이트와 비교하고 수정합니다. (분석 → 확인 → 실행)",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://devadmin.tncrental.co.kr/admin/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://devadmin.tncrental.co.kr/admin/goods.php*",
        "https://devadmin.tncrental.co.kr/admin/goods_input.php*"
      ],
      "js": [
        "lib/xlsx.full.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}